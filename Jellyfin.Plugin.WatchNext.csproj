<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Watch Next targets Jellyfin 12 and newer only, so there is no dual-target
      dance here: Jellyfin 12 runs on .NET 10 and that is the only runtime we
      build for.  The plugin is compiled against the OLDEST supported Jellyfin
      (12.0.0); Jellyfin assemblies are not strong-named, so the same build also
      binds on 12.1 and later.
    -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.0.0</JellyfinVersion>
    <TargetFramework>net10.0</TargetFramework>

    <RootNamespace>Jellyfin.Plugin.WatchNext</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.WatchNext</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ExcludeAssets="runtime" is required for all Jellyfin packages.
      Without it, the plugin DLL ships its own copies of Jellyfin assemblies
      and fails to load.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model"      Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\client.js" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
